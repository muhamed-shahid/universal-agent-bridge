# Universal Agent Bridge environment variables. All are optional.
# UAB never needs provider API keys or passwords. Coding CLIs keep their own login.

# Absolute path of the UAB data directory (database, logs).
# Default: %LOCALAPPDATA%\uab on Windows, ~/Library/Application Support/uab on macOS,
# $XDG_DATA_HOME/uab or ~/.local/share/uab on Linux.
# UAB_HOME=/absolute/path/to/uab-data

# Absolute path of a JSON configuration file. Default: <UAB_HOME>/config.json
# UAB_CONFIG=/absolute/path/to/config.json

# Log level for stderr output: debug | info | warn | error
# UAB_LOG_LEVEL=info
